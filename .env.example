APP_NAME=tem-platform
ENVIRONMENT=dev
LOG_LEVEL=INFO

POSTGRES_USER=tem_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tem_platform
DATABASE_URL=postgresql+asyncpg://tem_user:changeme@postgres:5432/tem_platform

REDIS_PASSWORD=changeme
REDIS_URL=redis://:changeme@redis:6379/0
TEST_DATABASE_URL=postgresql+asyncpg://test_user:test_password@test-postgres:5432/test_db

# --- Zitadel (local IdP, see docs/zitadel-local.md) -----------------------
# Everything below is a DEV-ONLY placeholder. Never reuse these values
# outside a local machine, and never commit real ones.

# Zitadel's own Postgres database. Separate from POSTGRES_* above on
# purpose — Zitadel's schema is not ours to migrate. See docs/zitadel-local.md.
ZITADEL_DB_USER=zitadel
ZITADEL_DB_PASSWORD=changeme
ZITADEL_DB_NAME=zitadel

# Encrypts secrets Zitadel stores at rest (its own DB, not ours). Must be
# exactly 32 characters. DEV-ONLY value — generate a real random one before
# this ever runs anywhere but a laptop, and never reuse this exact string.
ZITADEL_MASTERKEY=Dev-Only-ZITADEL-Masterkey-2026!

# Bootstrap admin created on first boot only (ignored on later starts).
# DEV-ONLY credentials — this is a throwaway local instance.
ZITADEL_ADMIN_USERNAME=zitadel-admin@zitadel.localhost
ZITADEL_ADMIN_EMAIL=zitadel-admin@zitadel.localhost
ZITADEL_ADMIN_PASSWORD=DevOnlyPassw0rd!

# Dev user created in the dedicated local development organisation.
# DEV-ONLY credentials for local testing; never use outside a laptop.
ZITADEL_DEV_USERNAME=dev-user
ZITADEL_DEV_EMAIL=dev-user@tem-platform.local
ZITADEL_DEV_PASSWORD=DevOnlyPassw0rd!

# Container path where Zitadel writes the bootstrap PAT on first boot.
# The host directory `.zitadel-bootstrap/` is ignored and never committed.
ZITADEL_BOOTSTRAP_PAT_PATH=/run/zitadel-bootstrap/admin.pat

# `iss` in every access token, and where the app's JWKS fetch (W2-04) points.
# The hostname is the Compose service name, not "localhost" — see the
# issuer trap section of docs/zitadel-local.md before changing this.
ZITADEL_ISSUER=http://zitadel:8080
# Filled in after creating the project via the Zitadel console (see
# docs/zitadel-local.md) — this is a per-instance ID, there is no
# reasonable default.
ZITADEL_PROJECT_ID=


ZITADEL_MANAGEMENT_CLIENT_ID=any-id
ZITADEL_MANAGEMENT_CLIENT_SECRET=any-secret
ZITADEL_HTTP_TIMEOUT_SECONDS=5.0

BOOTSTRAP_ADMIN_TOKEN=dev-only-bootstrap-secret-change-me
# --- Scan scope (W4-02, ADR-0004 §8) --------------------------------------
# Default-deny allowlist: comma-separated hostnames, IPs, CIDRs, and
# `host:port` loopback entries. Empty (or unset) means nothing may be
# scanned. Link-local / multicast are never allowed, not even listed.
# This is the four lab services as the worker sees them on the compose
# network (see docs/target-lab.md).
SCAN_SCOPE_ALLOWLIST=lab-nginx,lab-apache,lab-nonstandard,lab-tls-san
